  (gr_text "PoE" (at 161.5 53.64) (layer "Dwgs.User") (tstamp 6528a76f-b7a7-4621-952f-d7da1058963a)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (gr_text "Header is the low-Y edge (bottom of the default KiCad view). USB and Ethernet are off the high-X edge. Screws, the servo row, and the compass are on the high-Y edge, 20 mm past the HAT. The left edge is 20 mm past the HAT, away from USB. Parts in the column left of the board did not fit in that outline. Copper is not routed." (at 32.5 20) (layer "Cmts.User") (tstamp 11111111-1111-4111-8111-111111111111)
    (effects (font (size 1 1) (thickness 0.15)))
  )

