#!/bin/sh
set -e

ensure_user() {
    if getent passwd doggy >/dev/null 2>&1; then
        return 0
    fi

    useradd --system --no-create-home --home /nonexistent \
        --shell /usr/sbin/nologin --comment "doggy robot dog" doggy
}

ensure_i2c_group() {
    if getent group i2c >/dev/null 2>&1; then
        usermod -aG i2c doggy
    fi
}

ensure_dialout_group() {
    if getent group dialout >/dev/null 2>&1; then
        usermod -aG dialout doggy
    fi
}

ensure_video_group() {
    if getent group video >/dev/null 2>&1; then
        usermod -aG video doggy
    fi
}

install_mediamtx() {
    installer="${DOGGY_MEDIAMTX_INSTALLER:-/usr/lib/doggy/install-mediamtx.sh}"
    if [ "${DOGGY_SKIP_MEDIAMTX_INSTALL:-}" = 1 ]; then
        return 0
    fi
    if [ -x "$installer" ]; then
        "$installer"
    fi
}

ensure_tls_files() {
    if [ "${DOGGY_SKIP_TLS:-}" = 1 ]; then
        return 0
    fi
    cfg_dir="${DOGGY_CONFIG_DIR:-/etc/doggy}"
    cert="$cfg_dir/tls.crt"
    key="$cfg_dir/tls.key"
    if [ -s "$cert" ] && [ -s "$key" ]; then
        return 0
    fi
    umask 077
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
        -subj /CN=doggy.local -keyout "$key" -out "$cert"
    chown doggy:doggy "$cert" "$key"
    chmod 0644 "$cert"
    chmod 0600 "$key"
}

i2c_dtparam_enabled() {
    grep -Eq '^[[:space:]]*dtparam=i2c(_arm)?=on' "$1"
}

resolve_boot_config() {
    if [ -n "${DOGGY_BOOT_CONFIG:-}" ]; then
        printf '%s' "$DOGGY_BOOT_CONFIG"
        return 0
    fi

    if [ -f /boot/firmware/config.txt ]; then
        printf '%s' /boot/firmware/config.txt
        return 0
    fi

    if [ -f /boot/config.txt ]; then
        printf '%s' /boot/config.txt
        return 0
    fi

    return 1
}

enable_i2c_boot_config() {
    boot_config=""
    if boot_config=$(resolve_boot_config); then
        :
    else
        return 1
    fi

    if [ -f "$boot_config" ]; then
        :
    else
        return 1
    fi

    if i2c_dtparam_enabled "$boot_config"; then
        return 1
    fi

    if grep -Eq '^[[:space:]]*#[[:space:]]*dtparam=i2c_arm=on' "$boot_config"; then
        sed -i 's/^[[:space:]]*#[[:space:]]*dtparam=i2c_arm=on.*/dtparam=i2c_arm=on/' \
            "$boot_config"
    elif grep -Eq '^[[:space:]]*dtparam=i2c_arm=off' "$boot_config"; then
        sed -i 's/^[[:space:]]*dtparam=i2c_arm=off.*/dtparam=i2c_arm=on/' \
            "$boot_config"
    else
        printf '\n# Enabled by shaloms-doggy\ndtparam=i2c_arm=on\n' >>"$boot_config"
    fi

    modules_dir="${DOGGY_MODULES_LOAD_DIR:-/etc/modules-load.d}"
    if [ -d "$modules_dir" ]; then
        printf 'i2c-dev\n' >"$modules_dir/shaloms-doggy-i2c.conf"
    fi

    return 0
}

mark_reboot_required() {
    reboot_file="${DOGGY_REBOOT_REQUIRED:-/var/run/reboot-required}"
    reboot_pkgs="${DOGGY_REBOOT_PKGS:-/var/run/reboot-required.pkgs}"
    reboot_dir=$(dirname "$reboot_file")
    if [ -d "$reboot_dir" ]; then
        printf '*** System restart required ***\n' >"$reboot_file"
        printf 'shaloms-doggy\n' >>"$reboot_pkgs"
    fi
}

ask_reboot() {
    if [ "${DOGGY_SKIP_DEBCONF:-}" = 1 ]; then
        return 0
    fi

    if [ -f /usr/share/debconf/confmodule ]; then
        . /usr/share/debconf/confmodule
        db_version 2.0
        db_input high shaloms-doggy/reboot-now || true
        db_go || true
        db_get shaloms-doggy/reboot-now || true
        if [ "$RET" = true ]; then
            if command -v shutdown >/dev/null 2>&1; then
                shutdown -r +1 "shaloms-doggy: reboot to enable I2C" || true
            fi
        fi

        db_stop || true
    else
        echo "I2C was enabled in the boot config. Reboot before using the servos." >&2
    fi
}

ensure_log_dir() {
    log_dir="${DOGGY_LOG_DIR:-/var/log/doggy}"
    mkdir -p "$log_dir"
    if getent passwd doggy >/dev/null 2>&1; then
        chown doggy:doggy "$log_dir" || true
    fi

    chmod 0750 "$log_dir" || true
}

ensure_media_dirs() {
    recordings="${DOGGY_RECORDINGS_DIR:-/var/lib/doggy/recordings}"
    snapshots="${DOGGY_SNAPSHOTS_DIR:-/var/lib/doggy/snapshots}"
    mkdir -p "$recordings" "$snapshots"
    if getent passwd doggy >/dev/null 2>&1; then
        chown doggy:doggy "$recordings" "$snapshots" || true
    fi
    chmod 0750 "$recordings" "$snapshots" || true
}

ensure_config_dir() {
    cfg_dir="${DOGGY_CONFIG_DIR:-/etc/doggy}"
    mkdir -p "$cfg_dir"
    if getent passwd doggy >/dev/null 2>&1; then
        chown doggy:doggy "$cfg_dir" || true
    fi

    chmod 0755 "$cfg_dir" || true
}

reload_and_start() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload
        systemctl enable mediamtx.service
        systemctl enable doggy.service
        systemctl enable doggy-lora.service
        systemctl enable doggy-cleanup-media.timer
        if systemctl restart mediamtx.service; then
            :
        else
            echo "warning: systemctl restart mediamtx.service failed" >&2
            systemctl start mediamtx.service \
                || echo "warning: systemctl start mediamtx.service failed" >&2
        fi
        if systemctl restart doggy.service; then
            :
        else
            echo "warning: systemctl restart doggy.service failed" >&2
            systemctl start doggy.service \
                || echo "warning: systemctl start doggy.service failed" >&2
        fi
        if systemctl restart doggy-lora.service; then
            :
        else
            echo "warning: systemctl restart doggy-lora.service failed" >&2
            systemctl start doggy-lora.service \
                || echo "warning: systemctl start doggy-lora.service failed" >&2
        fi
        systemctl start doggy-cleanup-media.timer \
            || echo "warning: systemctl start doggy-cleanup-media.timer failed" >&2
    fi
}

case "$1" in
    configure)
        ensure_user
        ensure_i2c_group
        ensure_dialout_group
        ensure_video_group
        ensure_log_dir
        ensure_config_dir
        ensure_media_dirs
        install_mediamtx
        ensure_tls_files
        reload_and_start
        if enable_i2c_boot_config; then
            mark_reboot_required
            ask_reboot
        fi
        ;;
esac

exit 0
