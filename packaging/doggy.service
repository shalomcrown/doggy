[Unit]
Description=shaloms-doggy robot dog web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=doggy
Group=doggy
SupplementaryGroups=i2c
LogsDirectory=doggy
ExecStart=/usr/bin/doggy
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
