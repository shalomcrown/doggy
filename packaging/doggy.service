[Unit]
Description=shaloms-doggy robot dog web UI
After=network-online.target mediamtx.service avahi-daemon.service
Wants=network-online.target mediamtx.service avahi-daemon.service

[Service]
Type=simple
User=doggy
Group=doggy
SupplementaryGroups=i2c video
LogsDirectory=doggy
LogsDirectoryMode=0755
StateDirectory=doggy
ReadWritePaths=/var/lib/doggy
ExecStart=/usr/bin/doggy
ExecStopPost=-/usr/bin/pkill -KILL -x rpicam-vid
ExecStopPost=-/usr/bin/pkill -KILL -f rtsp://127.0.0.1:8554/
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
