[Unit]
Description=shaloms-doggy robot dog web UI
After=network-online.target mediamtx.service avahi-daemon.service
Wants=network-online.target mediamtx.service avahi-daemon.service

[Service]
Type=simple
User=doggy
Group=doggy
SupplementaryGroups=i2c video
LogsDirectory=doggy
LogsDirectoryMode=0755
StateDirectory=doggy
ReadWritePaths=/var/lib/doggy
ExecStart=/usr/bin/doggy
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
