{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "Raspberry Pi native Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "displayName": "Raspberry Pi native Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ubuntu-aarch64-cross",
      "displayName": "Ubuntu x86_64 → Raspberry Pi aarch64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ubuntu-aarch64-cross",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSROOT": "$env{DOGGY_SYSROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "ubuntu-aarch64-cross",
      "configurePreset": "ubuntu-aarch64-cross"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    }
  ]
}
